let currentQuiz=[];
let currentQuestionIndex=0;
let currentScore=0;

function openQuiz(){

  document.getElementById(
    "quizOverlay"
  ).style.display="flex";

  currentQuiz=[...quizQuestions]
  .sort(()=>0.5-Math.random())
  .slice(0,15);

  currentQuestionIndex=0;
  currentScore=0;

  document.getElementById(
    "quizResult"
  ).style.display="none";

document.getElementById(

  "progressText"

).innerText="0%";

document.getElementById(

  "progressBar"

).style.width="0%";

  showQuestion();
}

function showQuestion(){

  const q=currentQuiz[currentQuestionIndex];

  document.getElementById(
    "quizCounter"
  ).innerText=
  `Frage ${currentQuestionIndex+1} von 15`;

  document.getElementById(
    "quizQuestion"
  ).innerText=q.question;

let percent =

Math.round(((currentQuestionIndex+1)/15)*100);

document.getElementById(

  "progressBar"

).style.width =

percent + "%";

document.getElementById(

  "progressText"

).innerText =

percent + "%";

  const optionsDiv=
  document.getElementById("quizOptions");

  optionsDiv.innerHTML="";

  q.options.forEach((option,index)=>{

    const btn=document.createElement("button");

    btn.innerText=option;

    btn.style.padding="16px";
    btn.style.borderRadius="12px";
    btn.style.border="2px solid #ddd";
    btn.style.background="white";
    btn.style.textAlign="left";

    btn.onclick=()=>selectAnswer(index);

    optionsDiv.appendChild(btn);

  });

}

function selectAnswer(selected){

  const q=currentQuiz[currentQuestionIndex];

  const buttons=
  document.querySelectorAll("#quizOptions button");

  buttons.forEach(btn=>{
    btn.disabled=true;
  });

  if(selected===q.answer){

    buttons[selected].style.background="#35b56a";
    buttons[selected].style.color="white";

    currentScore++;

  }else{

    buttons[selected].style.background="#e74c3c";
    buttons[selected].style.color="white";

    buttons[q.answer].style.background="#35b56a";
    buttons[q.answer].style.color="white";
  }

  setTimeout(()=>{

    currentQuestionIndex++;

    if(currentQuestionIndex<15){
      showQuestion();
    }
    else{
      finishQuiz();
    }

  },2000);

}

function finishQuiz(){

  document.getElementById(
    "quizQuestion"
  ).innerText="";

  document.getElementById(
    "quizOptions"
  ).innerHTML="";

  document.getElementById(
    "quizCounter"
  ).innerText="";

  document.getElementById(
    "progressBar"
  ).style.width="Quiz beendet 🎉";

  document.getElementById(
    "progressText"
  ).innerText="100%";

  document.getElementById(
    "finalScore"
  ).innerText=
`Punkte: ${currentScore}/15`;

  document.getElementById(
    "quizResult"
  ).style.display="block";

}

function restartQuiz(){
  openQuiz();
}

function closeQuiz(){

  document.getElementById(
    "quizOverlay"
  ).style.display="none";

  document.getElementById(
    "quizResult"
  ).style.display="none";

}


