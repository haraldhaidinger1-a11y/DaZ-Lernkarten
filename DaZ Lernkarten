<div class="controls">

<button class="filter-btn gray active"
onclick="filterCards('all', this)">
Alle
</button>

<button class="filter-btn blue"
onclick="filterCards('sprachwissenschaft', this)">
Sprachwissenschaft
</button>

<button class="filter-btn green"
