</button>

</div>

<div class="controls">

<button class="gray" onclick="shuffleCards()">
🔀 Zufallsmodus
</button>

<button class="dark-btn" onclick="toggleDarkMode()">
🌙 Dark Mode
</button>

<button class="gray" onclick="resetCards()">
♻️ Reset
</button>

<input
class="search"
type="text"
id="searchInput"
placeholder="🔍 Begriff suchen..."
onkeyup="searchCards()"
>

</div>

<div class="stats" id="stats">
0 Karten sichtbar
</div>

</header>

